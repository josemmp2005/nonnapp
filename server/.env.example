PORT=3001
NODE_ENV=development

# Postgres local (ver docker-compose.yml en la raíz del proyecto)
DATABASE_URL=postgres://sabora:sabora@localhost:5434/sabora

# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS (el front de Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Groq: genera el texto de las recetas y el chat del chef — SOLO aquí, nunca con prefijo VITE_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini: solo para generar imágenes de las recetas (opcional)
GEMINI_API_KEY=
GEMINI_MODEL_IMAGE=imagen-3.0-generate-001

# Envío de emails (recuperación de contraseña, bienvenida). Opcional en dev:
# si se dejan vacías, el servidor solo hace console.log del email en vez de enviarlo.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Login con Google (opcional). Credenciales OAuth 2.0 de Google Cloud Console
# ("Credenciales" → "Crear credenciales" → "ID de cliente de OAuth", tipo
# "Aplicación web"). En "URI de redireccionamiento autorizados" hay que dar de
# alta exactamente GOOGLE_REDIRECT_URI. Si se dejan vacías, /api/auth/google
# devuelve 503 en vez de romper el resto del login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
