PORT=3001
NODE_ENV=development

# Postgres local (ver docker-compose.yml en la raíz del proyecto).
# En producción (Neon, Render Postgres, etc.) esta URL la da el propio
# proveedor y suele incluir ?sslmode=require — pon también DB_SSL=true
# en ese caso (ver abajo), si no la conexión falla igualmente.
DATABASE_URL=postgres://sabora:sabora@localhost:5434/sabora

# true solo con un Postgres gestionado que exige TLS (Neon, Render, Railway...).
# El Postgres local de docker-compose no lo soporta — déjalo en false/vacío ahí.
DB_SSL=false

# Genera uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origen permitido para CORS y base de los links que manda el servidor
# (verificación de email, reset de contraseña, callback de Google).
# En producción: la URL del frontend desplegado (p.ej. https://tuapp.vercel.app),
# NUNCA '*' — con cookies (credentials: true) el navegador lo rechaza.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Groq: genera el texto de las recetas y el chat del chef — SOLO aquí, nunca con prefijo VITE_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Envío de emails (verificación, recuperación de contraseña, bienvenida) vía
# Brevo (API HTTP, no SMTP — el SMTP saliente está bloqueado en el plan
# gratuito de Render y similares). Cuenta gratis en brevo.com (300 emails/día
# para siempre); en Senders, Domains & Dedicated IPs → Senders, verifica un
# email normal tuyo (sin necesitar dominio propio) y úsalo en BREVO_FROM — a
# diferencia de Resend, Brevo deja mandar a cualquier destinatario sin
# verificar un dominio. Opcional en dev: si se deja vacía, el servidor solo
# hace console.log del email en vez de enviarlo.
BREVO_API_KEY=
BREVO_FROM=Sabora <tu-email-verificado-en-brevo@example.com>

# Login con Google (opcional). Credenciales OAuth 2.0 de Google Cloud Console
# ("Credenciales" → "Crear credenciales" → "ID de cliente de OAuth", tipo
# "Aplicación web"). En "URI de redireccionamiento autorizados" hay que dar de
# alta exactamente GOOGLE_REDIRECT_URI. Si se dejan vacías, /api/auth/google
# devuelve 503 en vez de romper el resto del login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
