# Variables de entorno para `npm test` — sin secretos reales, seguro de
# commitear. Apunta a una base de datos de pruebas separada de la de
# desarrollo (misma instancia de Postgres del docker-compose de la raíz,
# solo cambia el nombre de la BBDD) para no pisar datos reales.
NODE_ENV=test
PORT=3002
JWT_SECRET=test-secret-not-for-production-use
DATABASE_URL=postgres://sabora:sabora@localhost:5434/sabora_test
DB_SSL=false
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
BREVO_API_KEY=
BREVO_FROM=Sabora <no-reply@example.com>
