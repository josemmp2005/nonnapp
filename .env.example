# En producción: la URL pública del backend (p.ej. https://nonnapp-api.onrender.com).
# Vite la incrusta en el build en tiempo de compilación — configúrala como
# variable de entorno en Vercel/Netlify, no la cambies solo en runtime.
VITE_API_URL=http://localhost:3001

# Opcional, solo en desarrollo (npm run dev): usa una receta de prueba en vez
# de llamar a la IA de verdad, útil si se agota la cuota. Sin efecto en build
# de producción bajo ninguna circunstancia.
VITE_USE_MOCK_RECIPE=false
