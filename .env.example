# En producción (Netlify): NO la definas (bórrala del panel si ya estaba puesta
# con una URL) — así las llamadas quedan relativas y las resuelve el proxy de
# public/_redirects (/api/* -> el backend), con la API en el mismo dominio que
# la app para el navegador, así Safari/iOS no trata la cookie de sesión como
# "de terceros". Poniéndola a una URL (p.ej. https://sabora.onrender.com) se
# llama al backend directo, sin proxy — sigue funcionando pero vuelve a ese
# problema; úsalo solo si no puedes montar el proxy.
# Vite la incrusta en el build en tiempo de compilación: cambiarla en Netlify no
# basta, hay que volver a desplegar (con caché limpia) para que se note.
VITE_API_URL=http://localhost:3001

# Opcional, solo en desarrollo (npm run dev): usa una receta de prueba en vez
# de llamar a la IA de verdad, útil si se agota la cuota. Sin efecto en build
# de producción bajo ninguna circunstancia.
VITE_USE_MOCK_RECIPE=false
