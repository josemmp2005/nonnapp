# En producción (Netlify): déjala VACÍA ("") para usar el proxy de
# public/_redirects (/api/* -> el backend) — el navegador ve la API en el
# mismo dominio que la app, así Safari/iOS no trata la cookie de sesión como
# "de terceros". Con una URL (p.ej. https://sabora.onrender.com) se llama al
# backend directo, sin proxy — sigue funcionando pero vuelve a ese problema.
# Vite la incrusta en el build en tiempo de compilación, no la cambies solo en runtime.
VITE_API_URL=http://localhost:3001

# Opcional, solo en desarrollo (npm run dev): usa una receta de prueba en vez
# de llamar a la IA de verdad, útil si se agota la cuota. Sin efecto en build
# de producción bajo ninguna circunstancia.
VITE_USE_MOCK_RECIPE=false
